{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpore/lore/creature.schema.json",
  "title": "Primigenia creature lore (A22, docs/LORE-FORMAT.md)",
  "type": "object",
  "required": ["schema", "id", "name", "status", "stage", "niche", "body", "chains", "provenance", "changelog"],
  "additionalProperties": false,
  "$defs": {
    "i18n": {"type": "object", "required": ["en"], "properties": {"en": {"type": "string"}, "es": {"type": "string"}}, "additionalProperties": false},
    "refs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "analogue": {"type": "object", "required": ["organism", "mechanism"], "additionalProperties": false,
      "properties": {"organism": {"type": "string"}, "mechanism": {"type": "string"}, "refs": {"$ref": "#/$defs/refs"}}},
    "plausibility": {"type": "object", "required": ["verdict", "judge", "date"], "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["plausible", "fixable", "implausible", "unreviewed"]},
        "judge": {"type": "string"}, "date": {"type": "string", "format": "date"},
        "summary": {"type": "string"},
        "analogues": {"type": "array", "items": {"$ref": "#/$defs/analogue"}},
        "fixes": {"type": "array", "items": {"type": "string"}},
        "scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 10}}}},
    "provenance": {"type": "object", "additionalProperties": false,
      "properties": {"council_run": {"type": "string"}, "by": {"type": "array", "items": {"type": "string"}}, "edited_by": {"type": "string"}}},
    "skill": {"type": "object", "required": ["id", "name", "role", "effect"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
        "name": {"$ref": "#/$defs/i18n"},
        "role": {"enum": ["Basic", "Engage", "Poke", "Control", "Defence", "Signature", "Passive", "Social"]},
        "effect": {"type": "string"},
        "numbers": {"type": "object", "additionalProperties": {"type": "number"}}}},
    "chain": {"type": "object", "required": ["id", "trait", "links", "roots", "skill", "weakness", "observe", "journal", "plausibility"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+\\.c[0-9]+$"},
        "trait": {"type": "string"},
        "links": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
        "roots": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F[0-9]+$"}},
        "skill": {"$ref": "#/$defs/skill"},
        "weakness": {"type": "string"},
        "observe": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "journal": {"$ref": "#/$defs/i18n"},
        "plausibility": {"$ref": "#/$defs/plausibility"},
        "provenance": {"$ref": "#/$defs/provenance"}}}
  },
  "properties": {
    "schema": {"const": "cpore.creature/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"$ref": "#/$defs/i18n"},
    "status": {"enum": ["draft", "reviewed", "canon"]},
    "stage": {"enum": ["cell", "creature", "band", "realm", "industry", "space"]},
    "niche": {"type": "object", "required": ["habitat", "diet", "active", "predators"], "additionalProperties": false,
      "properties": {"habitat": {"type": "string"}, "diet": {"type": "string"}, "active": {"type": "string"},
                     "predators": {"type": "array", "items": {"type": "string"}}, "prey": {"type": "array", "items": {"type": "string"}}}},
    "body": {"type": "string"},
    "temperament": {"type": "string"},
    "chains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chain"}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["with", "kind", "note"], "additionalProperties": false,
      "properties": {"with": {"type": "string"}, "kind": {"enum": ["predation", "prey", "convergent", "opposite", "symbiosis", "mimicry", "rivalry", "counter", "cousin"]},
                     "via": {"type": "string"}, "note": {"type": "string"}}}},
    "journal": {"type": "array", "items": {"$ref": "#/$defs/i18n"}},
    "secrets": {"type": "array", "items": {"type": "string"}},
    "moments": {"type": "array", "items": {"type": "string"}},
    "game": {"type": "object", "description": "links to game data: species id in C, part ids, move ids", "additionalProperties": true},
    "provenance": {"$ref": "#/$defs/provenance"},
    "changelog": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "who", "what"], "additionalProperties": false,
      "properties": {"date": {"type": "string"}, "who": {"type": "string"}, "what": {"type": "string"}}}}
  }
}
