[configuration]
entry_symbol = "cpore_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libcpore.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcpore.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libcpore.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcpore.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libcpore.macos.template_debug.universal.dylib"
macos.release = "res://bin/libcpore.macos.template_release.universal.dylib"
