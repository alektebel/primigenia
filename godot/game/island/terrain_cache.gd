extends RefCounted
# On-disk cache of generated islands: user://terrain/island-<seed>-t<ver>-r<prep>-g<stamp>-<digest>.bin
# zstd-compressed; magic + format + one Variant (no objects). A hit is verified by the C hash, which only proves the file is
# intact, not that today's generator would make the same island: CP_TERRAIN_VERSION is not bumped for every terrain change
# (the route curation moved the first cave and the old cache kept loading the old island). So the key also carries the
# generator stamp, the hash of a small reference island generated by the running build: a changed generator changes the stamp,
# old files simply stop matching and the island is rebuilt (they are left on disk, unused).
# An authored island (core/include/cpore/island.h) adds its id and the hex cp_island_hash of its blob to the params as
# "island" and "island_hash": the file name then carries both (and the digest covers them), so editing the island JSON
# misses the old file even when the generator is unchanged. Without "island_hash" the key is the seed island's, as before.
# The blob itself is passed as params["island_blob"] (PackedByteArray): resolve() turns it into "island" and "island_hash"
# (CporeTerrain.island_info) and drops it from the key. An authored island also carries the climate maps (island-realism plan part
# II, M2): entries hold "climate" (RGBA8 climate_n^2), "biome" (n*n), "veg" (n*n*4), "climate_n" and "climate_hash", verified on load,
# and the file name carries the climate kernel version (CP_CLIMATE_VERSION) so a changed kernel misses old files. Entries also hold "trail" (n*n,
# the game-trail lanes) and "trunks" (5 floats per record, core/src/flora_place.c) with "flora_version" (M3).

const TerrainData := preload("res://game/island/terrain_data.gd")

# B1 (island-realism plan, A101): the game's island is the frozen Star massif. game_params(seed) are the params every game entry
# and every test that wants "the game island" passes to load_entry / build: the seed (micro detail only, A99 (1)), the desc's
# grid size and the blob. Plain {"seed": s} params still mean the seed-generated layout-0 ring island (terrain tests, parity).
const STAR_BLOB_PATH := "res://game/data/islands/star_massif.isl"
static var _star_blob := PackedByteArray()
static var _star_n := 0

static func star_blob() -> PackedByteArray:
	if _star_blob.is_empty():
		_star_blob = FileAccess.get_file_as_bytes(STAR_BLOB_PATH)
		var info: Dictionary = CporeTerrain.island_info(_star_blob)
		if info.get("error", -1) != 0:
			push_error("the shipped island %s does not parse (error %s)" % [STAR_BLOB_PATH, info.get("error")])
			_star_blob = PackedByteArray()
		else:
			_star_n = int(info.n)
	return _star_blob

static func game_params(seed: int = 1) -> Dictionary:
	var blob := star_blob()
	return {"seed": seed, "n": _star_n, "island_blob": blob}

const MAGIC := 0x30304D43  # "CM00"
const FORMAT_VERSION := 1
const DEFAULT_DIR := "user://terrain"

static func resolve(params: Dictionary) -> Dictionary:
	var out: Dictionary = CporeTerrain.defaults()
	for k in params:
		out[k] = params[k]
	var defaults: Dictionary = CporeTerrain.defaults()
	for k in defaults:
		out[k] = int(out[k]) if typeof(defaults[k]) == TYPE_INT else float(out[k])
	if out.has("island_blob"):
		var info: Dictionary = CporeTerrain.island_info(out["island_blob"])
		if info.get("error", -1) == 0:
			out["island"] = info.id
			out["island_hash"] = info.hash
		out.erase("island_blob")
	return out

const STAMP_PARAMS := {"seed": 1, "n": 128}
static var _stamp := ""
static var stamp_override := ""     # tests only: pretend to be another generator

## The hash of the reference island the running generator makes (cached for the process; tens of milliseconds).
static func generator_stamp() -> String:
	if stamp_override != "":
		return stamp_override
	if _stamp == "":
		var p: Dictionary = CporeTerrain.defaults()
		for k in STAMP_PARAMS:
			p[k] = STAMP_PARAMS[k]
		var e: Dictionary = CporeTerrain.new().generate(p)
		_stamp = String(e.get("hash", "")).left(8) if e.get("error", -1) == 0 else "nogen"
	return _stamp

static func digest(params: Dictionary) -> String:
	var pairs := []
	var keys := params.keys()
	keys.sort()
	for k in keys:
		pairs.append([k, params[k]])
	return JSON.stringify(pairs).sha256_text().left(16)

## "" for the seed islands; "-i<id>-d<desc hash>" for an authored island.
static func island_tag(p: Dictionary) -> String:
	var h := str(p.get("island_hash", ""))
	if h == "":
		return ""
	return "-i%s-d%s-c%d" % [str(p.get("island", "x")).validate_filename().left(24), h.left(16), CporeTerrain.climate_version()]

static func cache_path(params: Dictionary, dir: String = DEFAULT_DIR) -> String:
	var p := resolve(params)
	return "%s/island-%d-t%d-r%d-g%s%s-%s.bin" % [dir, p.seed, CporeTerrain.version(), TerrainData.RENDER_PREP_VERSION, generator_stamp(), island_tag(p), digest(p)]

static func _valid(entry: Dictionary, params: Dictionary) -> bool:
	for key in ["height", "flow", "sediment", "water_level"]:
		if typeof(entry.get(key)) != TYPE_PACKED_FLOAT32_ARRAY:
			return false
	for key in ["material", "river", "surface", "relief"]:
		if typeof(entry.get(key)) != TYPE_PACKED_BYTE_ARRAY:
			return false
	if typeof(entry.get("chunk_bounds")) != TYPE_PACKED_FLOAT32_ARRAY or typeof(entry.get("caves")) != TYPE_ARRAY:
		return false
	if typeof(entry.get("volcano")) != TYPE_VECTOR4 or typeof(entry.get("hash")) != TYPE_STRING:
		return false
	if typeof(entry.get("n")) != TYPE_INT or typeof(entry.get("params")) != TYPE_DICTIONARY:
		return false
	var n: int = entry.n
	if str(params.get("island_hash", "")) != "":   # an authored island: the climate maps, byte-exact
		for key in ["climate", "biome", "veg"]:
			if typeof(entry.get(key)) != TYPE_PACKED_BYTE_ARRAY:
				return false
		var cn = entry.get("climate_n")
		if typeof(cn) != TYPE_INT or cn < 1 or entry.climate.size() != 256 * 256 * 4 or entry.biome.size() != n * n or entry.veg.size() != n * n * 4:
			return false
		if typeof(entry.get("climate_hash")) != TYPE_STRING or CporeTerrain.climate_hash(entry) != entry.climate_hash:
			return false
		# island-realism M3: the game-trail lanes and the sim's trunks come with the maps; a file made before them, or by another placement, is a miss
		if typeof(entry.get("trail")) != TYPE_PACKED_BYTE_ARRAY or entry.trail.size() != n * n:
			return false
		if typeof(entry.get("trunks")) != TYPE_PACKED_FLOAT32_ARRAY or entry.trunks.size() % 5 != 0 or entry.get("flora_version") != CporeTerrain.flora_version():
			return false
	if n < 8 or entry.height.size() != n * n or entry.flow.size() != n * n or entry.sediment.size() != n * n \
			or entry.water_level.size() != n * n or entry.material.size() != n * n or entry.river.size() != n * n or entry.surface.size() != n * n * 4 \
			or entry.relief.size() != n * n * 4:
		return false
	if entry.get("version") != CporeTerrain.version() or entry.get("render_prep") != TerrainData.RENDER_PREP_VERSION:
		return false
	if entry.params != params or entry.get("seed") != params.seed:
		return false
	if typeof(entry.get("vheight")) != TYPE_PACKED_BYTE_ARRAY or typeof(entry.get("vmaps")) != TYPE_PACKED_BYTE_ARRAY or typeof(entry.get("vn")) != TYPE_INT:
		return false
	var vn: int = entry.vn
	if vn != n * TerrainData.visual_factor(n) or entry.vheight.size() != vn * vn * 2 or entry.vmaps.size() != (vn / 2) * (vn / 2) * 4:
		return false
	if typeof(entry.get("vh_min")) != TYPE_FLOAT or typeof(entry.get("vh_range")) != TYPE_FLOAT or typeof(entry.get("vhash")) != TYPE_STRING:
		return false
	var cps: int = (n + TerrainData.CHUNK_CELLS - 1) / TerrainData.CHUNK_CELLS
	if entry.get("chunks_per_side") != cps or entry.chunk_bounds.size() != cps * cps * 2:
		return false
	return CporeTerrain.hash(entry) == entry.hash

# Returns the verified entry, or {} on any miss/corruption.
static func load_entry(params: Dictionary, dir: String = DEFAULT_DIR) -> Dictionary:
	var p := resolve(params)
	var path := cache_path(p, dir)
	if not FileAccess.file_exists(path):
		return {}
	var f := FileAccess.open_compressed(path, FileAccess.READ, FileAccess.COMPRESSION_ZSTD)
	if f == null:
		return {}
	if f.get_32() != MAGIC or f.get_32() != FORMAT_VERSION:
		return {}
	var v = f.get_var(false)
	if f.get_error() != OK or typeof(v) != TYPE_DICTIONARY or not _valid(v, p):
		return {}
	return v

static func save_entry(params: Dictionary, entry: Dictionary, dir: String = DEFAULT_DIR) -> bool:
	var path := cache_path(params, dir)
	DirAccess.make_dir_recursive_absolute(dir)
	var tmp := path + ".tmp"
	var f := FileAccess.open_compressed(tmp, FileAccess.WRITE, FileAccess.COMPRESSION_ZSTD)
	if f == null:
		return false
	f.store_32(MAGIC)
	f.store_32(FORMAT_VERSION)
	f.store_var(entry, false)
	f.close()
	return DirAccess.rename_absolute(tmp, path) == OK

# Generate + derived maps (+ save). `gen` is a CporeTerrain; safe on a worker thread.
static func build(params: Dictionary, gen, dir: String = DEFAULT_DIR, save: bool = true) -> Dictionary:
	var p := resolve(params)
	var opts := p.duplicate()
	if params.has("island_blob"):
		opts["island_blob"] = params["island_blob"]
	var entry: Dictionary = gen.generate(opts)
	if entry.get("error", -1) != 0:
		return entry
	TerrainData.prepare(entry)
	if save:
		save_entry(p, entry, dir)
	return entry

# Synchronous convenience: {entry, hit, ms}.
static func get_or_build(params: Dictionary, dir: String = DEFAULT_DIR) -> Dictionary:
	var t0 := Time.get_ticks_msec()
	var p := resolve(params)
	var entry := load_entry(p, dir)
	var hit := not entry.is_empty()
	if not hit:
		entry = build(params, CporeTerrain.new(), dir)
	return {"entry": entry, "hit": hit, "ms": Time.get_ticks_msec() - t0}
