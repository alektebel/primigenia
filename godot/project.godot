; Minimal project for the creature module tests (M1a). The final
; project.godot comes from the M0 foundation branch (godot-m0); the creature
; module needs no project settings beyond the GL Compatibility renderer.
config_version=5

[application]
config/name="Primigenia"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
