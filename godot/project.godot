; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Primigenia"
run/main_scene="res://game/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="primigenia"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Game="*res://game/game.gd"
Audio="*res://audio/audio_manager.gd"
Dev="*res://devtools/dev.gd"

[shader_globals]

cloud_cover={
"type": "float",
"value": 0.45
}
cloud_time={
"type": "float",
"value": 0.0
}
sky_tod={
"type": "float",
"value": 0.75
}
fog_amount={
"type": "float",
"value": 0.0
}
moon_k={
"type": "float",
"value": 0.0
}
sun_dir={
"type": "vec3",
"value": Vector3(-0.6259115, 0.2826697, -0.7268649)
}
sun_color={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
sun_vis={
"type": "float",
"value": 1.0
}
sky_zenith={
"type": "vec3",
"value": Vector3(0.13, 0.39, 0.84)
}
sky_mid={
"type": "vec3",
"value": Vector3(0.52, 0.7, 0.93)
}
sky_horizon={
"type": "vec3",
"value": Vector3(0.95, 0.84, 0.7)
}
sky_glow={
"type": "vec3",
"value": Vector3(1, 0.62, 0.3)
}
ambient_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
fog_color={
"type": "vec3",
"value": Vector3(0.34, 0.58, 0.88)
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

